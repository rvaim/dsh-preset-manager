{
  "name": "@rvaim/dsh-preset-manager",
  "version": "0.5.0",
  "description": "DeepSeek Harness Agent preset manager: register and manage agent presets at runtime without editing any DSH configuration file.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "agent-preset",
    "preset-manager",
    "persona"
  ],
  "homepage": "https://github.com/rvaim/dsh-preset-manager#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rvaim/dsh-preset-manager.git"
  },
  "bugs": {
    "url": "https://github.com/rvaim/dsh-preset-manager/issues"
  },
  "author": "rvaim",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "default": "./dist/host/index.js"
    },
    "./client": {
      "default": "./dist/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/host/",
    "dist/client.js",
    "dist/THIRD_PARTY_NOTICES.txt",
    "dist/shared/",
    "dist/domain/",
    "dist/sharing/",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "docs/",
    "resources/",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "0.2.1-rc.3"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "node scripts/run-tests.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run verify:binding && npm run verify:client && npm run verify:bundled",
    "prepublishOnly": "npm run verify",
    "pack:check": "npm pack --dry-run",
    "verify:binding": "node scripts/verify-binding.mjs",
    "verify:bundled": "node scripts/verify-bundled.mjs",
    "verify:client": "node scripts/verify-client.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.3",
    "@lezer/highlight": "1.2.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.25.10",
    "react": "^18.3.1",
    "typescript": "^5.9.3"
  }
}
